.eq_sc_layer_down, .eq_sc_expand {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_down.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_layer_down:hovered, .eq_sc_expand:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_down.png) color($(text));
}

.eq_sc_layer_up, .eq_sc_collapse {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_up.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_layer_up:hovered, .eq_sc_collapse:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_up.png) color($(text));
}

.eq_sc_all {
  overlay: sprite(embersquesting:textures/gui/icons/chevrons_vertical.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_all:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/chevrons_vertical.png) color($(text));
}

.eq_sc_ghost {
  overlay: sprite(embersquesting:textures/gui/icons/eye.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_ghost:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/eye.png) color($(text));
}

.eq_sc_ghost_off {
  overlay: sprite(embersquesting:textures/gui/icons/eye_off.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_ghost_off:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/eye_off.png) color($(text));
}

.eq_sc_build {
  overlay: sprite(embersquesting:textures/gui/icons/building.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_build:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/building.png) color($(text));
}

.eq_sc_prev {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_left.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_prev:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_left.png) color($(text));
}

.eq_sc_play {
  overlay: sprite(embersquesting:textures/gui/icons/play.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_play:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/play.png) color($(text));
}

.eq_sc_pause {
  overlay: sprite(embersquesting:textures/gui/icons/pause.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_pause:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/pause.png) color($(text));
}

.eq_sc_next {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_right.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_next:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/chevron_right.png) color($(text));
}

.eq_sc_restart {
  overlay: sprite(embersquesting:textures/gui/icons/refresh.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_restart:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/refresh.png) color($(text));
}

.eq_sc_enlarge {
  overlay: sprite(embersquesting:textures/gui/icons/zoom_in.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_sc_enlarge:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/zoom_in.png) color($(text));
}

.eq_scene_slot, .eq_recipe_slot {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
}

.eq_scene_slot.eq_scene_missing {
  background: $(danger.texture|sdf($(danger@38), 4, 1, $(danger@c0)));
}

.eq_recipe_arrow {
  background: sprite(embersquesting:textures/gui/icons/arrow_right.png) color($(text_soft));
}

.eq_recipe_flame {
  background: sprite(embersquesting:textures/gui/icons/fire.png) color($(text_soft));
}

.eq_recipe_shapeless {
  background: sprite(embersquesting:textures/gui/icons/shuffle.png) color($(text_soft));
}

.eq_scene_check {
  background: sprite(embersquesting:textures/gui/icons/check.png) color($(success));
}

.eq_media {
  background: $(bg.texture|sdf($(bg), 4, 1, $(border@4a)));
}

.eq_media_bar {
  background: $(panel.texture|rect($(panel@b0)));
}

.eq_media_bar .eq_icon_btn:host {
  base-background: empty;
  hover-background: rect($(text@20));
  pressed-background: rect($(text@30));
}

.eq_media_time {
  text-color: $(text);
  text-shadow: false;
}

.eq_media_title {
  text-color: $(text);
}

.eq_media_track {
  background: rect($(text@50));
}

.eq_media_seek:hovered .eq_media_track, .eq_media_volume:hovered .eq_media_track {
  background: rect($(text@70));
}

.eq_media_fill {
  background: $(accent.texture|rect($(accent)));
}

.eq_media_seek:hovered .eq_media_fill, .eq_media_volume:hovered .eq_media_fill {
  background: $(accent_hover.texture|$(accent.texture|rect($(accent_hover))));
}

.eq_media_sound {
  overlay: sprite(embersquesting:textures/gui/icons/volume.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_media_sound:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/volume.png) color($(text));
}

.eq_media_muted {
  overlay: sprite(embersquesting:textures/gui/icons/volume_x.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_media_muted:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/volume_x.png) color($(text));
}

.eq_media_shrink {
  overlay: sprite(embersquesting:textures/gui/icons/zoom_out.png) color($(text_soft));
  transition: overlay 0.15 QUAD_OUT;
}

.eq_media_shrink:hovered {
  overlay: sprite(embersquesting:textures/gui/icons/zoom_out.png) color($(text));
}

.eq_media_badge {
  background: $(panel.texture|sdf($(panel@c0), 4, 1, $(border@4a)));
}

.eq_media_screen:hovered .eq_media_badge {
  background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover@e0), 4, 1, $(border@70))));
}

.eq_media_badge_icon {
  background: sprite(embersquesting:textures/gui/icons/play.png) color($(text_soft));
}

.eq_media_screen:hovered .eq_media_badge_icon {
  background: sprite(embersquesting:textures/gui/icons/play.png) color($(text));
}

.eq_media_caption {
  background: $(panel.texture|rect($(panel@c0)));
  text-color: $(text);
  text-shadow: false;
}

.eq_media_wait {
  background: $(panel.texture|sdf($(panel@c0), 4, 1, $(border@4a)));
  text-color: $(text);
  text-shadow: false;
}

.eq_media_transcript {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
}

.eq_media_cue_time {
  text-color: $(text_dim);
  text-shadow: false;
}

.eq_media_cue_text {
  text-color: $(text_soft);
  text-shadow: false;
}

.eq_media_cue_active {
  background: $(accent.texture|sdf($(accent@30), 4));
}

.eq_media_cue_active .eq_media_cue_text {
  text-color: $(text);
}

.eq_media_cue:hovered {
  background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 4, 1, $(border@70))));
}

.eq_shop_list {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
}

.eq_shop_row {
  background: empty;
  transition: background 0.15 QUAD_OUT;
}

.eq_shop_row:hovered {
  background: sdf($(border@2a), 4);
}

.eq_shop_row.eq_shop_disabled:hovered {
  background: sdf($(border@16), 4);
}

.eq_shop_name {
  text-color: $(text);
  text-shadow: false;
}

.eq_shop_price {
  text-color: $(text_soft);
  text-shadow: false;
}

.eq_shop_row.eq_shop_disabled .eq_shop_name, .eq_shop_row.eq_shop_disabled .eq_shop_price {
  text-color: $(text_dim);
}

.eq_shop_row.eq_shop_locked .eq_shop_icon, .eq_shop_lock {
  color: $(node_locked_icon);
}

.eq_shop_add_text {
  text-color: $(accent);
  text-shadow: false;
}

.eq_shop_empty {
  text-color: $(text_dim);
  text-shadow: false;
}

.eq_shop_balance, .eq_shop_dialog_balance {
  text-color: $(text_note);
}

.eq_pin_glyph {
  color: $(pin|$(accent));
}

.eq_style_classiccopy_blank QuestNode.eq_node.eq_completed {
  background: group(sprite(embersquesting:textures/gui/shapes/rsquare.png) color(#212121), sprite(embersquesting:textures/gui/classic/sheen_rsquare.png) color(#96ffffff), sprite(embersquesting:textures/gui/shapes/rsquare_outline.png) color(#c856ff56));
}

.eq_style_deepaclassic_blank QuestNode.eq_node.eq_completed {
  background: group(sprite(embersquesting:textures/gui/shapes/rsquare.png) color(#212121), sprite(embersquesting:textures/gui/classic/sheen_rsquare.png) color(#96ffffff), sprite(embersquesting:textures/gui/shapes/rsquare_outline.png) color(#c856ff56));
  overlay: sprite(embersquesting:textures/gui/shapes/rsquare.png) color(#64ffffff);
}





.eq_style_deepaclassic_blank #eq_claim {
  base-background: sdf(#66000000, 5, 1, #14000000);
  hover-background: sdf(#66000000, 5, 1, #14000000);
  pressed-background: sdf(#66000000, 5, 1, #14000000);
  height: 16;
  padding-all: 3;
}

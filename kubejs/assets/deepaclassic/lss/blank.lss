.panel_bg {
  background: $(panel.texture|sdf($(panel@f2), 7, 1, $(border@4a)));
  padding-all: 6;
  gap-all: 5;
}

.preview_bg {
  background: $(bg.texture|sdf($(bg), 6, 1, $(border@4a)));
  padding-all: 4;
}

.configurator_preview_bg {
  background: $(field.texture|sdf($(field), 6, 1, $(border@4a)));
  padding-all: 4;
}

text, label {
  text-shadow: false;
  text-color: $(text);
}

button:host {
  base-background: $(raised.texture|sdf($(raised), 5, 1, $(border@4a)));
  hover-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 5, 1, $(border@70))));
  pressed-background: $(raised_pressed.texture|$(raised.texture|sdf($(raised_pressed), 5, 1, $(border@70))));
  padding-all: 3;
  height: 16;
}

button:host .__button_text__ {
  text-color: $(text);
  text-shadow: false;
}

button:disabled:host {
  base-background: $(raised_disabled.texture|$(raised.texture|sdf($(raised_disabled), 5, 1, $(border@4a))));
  hover-background: $(raised_disabled.texture|$(raised.texture|sdf($(raised_disabled), 5, 1, $(border@4a))));
  pressed-background: $(raised_disabled.texture|$(raised.texture|sdf($(raised_disabled), 5, 1, $(border@4a))));
}

button:disabled:host .__button_text__ {
  text-color: $(text_dim);
  text-shadow: false;
}

.__confirm-button__ {
  base-background: $(accent.texture|sdf($(accent), 5));
  hover-background: $(accent_hover.texture|$(accent.texture|sdf($(accent_hover), 5)));
  pressed-background: $(accent_pressed.texture|$(accent.texture|sdf($(accent_pressed), 5)));
}

.__confirm-button__ .__button_text__ {
  text-color: $(text_on_accent);
}

.__reject-button__ {
  base-background: $(danger.texture|sdf($(danger), 5));
  hover-background: $(danger_hover.texture|$(danger.texture|sdf($(danger_hover), 5)));
  pressed-background: $(danger_pressed.texture|$(danger.texture|sdf($(danger_pressed), 5)));
}

.__reject-button__ .__button_text__ {
  text-color: $(text_on_accent);
}

text-field, text-area {
  text-color: $(text);
  cursor-color: $(text);
  text-shadow: false;
}

text-field:host,
.__tag-field_text-field__,
.__search-component_text-field__ {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  focus-overlay: sdf(#00000000, 5, 1, $(accent));
  padding-all: 3;
}

search-component:host {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  focus-overlay: sdf(#00000000, 5, 1, $(accent));
  height: 16;
}

switch:host {
  base-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 6)));
  pressed-background: $(accent.texture|sdf($(accent), 6));
  unmark-background: sdf($(text_soft), 5);
  mark-background: sdf($(bg), 5);
  height: 12;
  width: 22;
  padding-all: 1;
}

selector:host {
  background: $(raised.texture|sdf($(raised), 5, 1, $(border@4a)));
  focus-overlay: sdf(#00000000, 5, 1, $(accent));
  height: 16;
  transition: background 0.15 QUAD_OUT;
}

selector:host:hovered {
  background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 5, 1, $(border@70))));
}

.__selector_button-icon__ {
  background: sprite(ldlib2:textures/gui/down.png) scale(0.55) color($(text_soft));
}

.__selector_dialog__, .__search-component_dialog__ {
  background: $(panel.texture|sdf($(panel@f7), 5, 1, $(border@70)));
  padding-all: 3;
}

progress-bar:host {
  height: 8;
}

progress-bar:host label {
  font-size: 6;
  text-color: $(text);
}

.__progress-bar_bar-container__ {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
  padding-all: 0;
}

.__progress-bar_bar__ {
  background: $(accent.texture|sdf($(accent), 4));
  padding-all: 0;
}

item-slot, .item-slot_bg {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
  hover-overlay: sdf($(border@3c), 4);
}

fluid-slot, .fluid-slot_bg {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
}

color-selector:host text-field {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  focus-overlay: sdf(#00000000, 5, 1, $(accent));
  padding-all: 3;
}

color-selector:host button {
  base-background: $(raised.texture|sdf($(raised), 4, 1, $(border@4a)));
  hover-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 4, 1, $(border@70))));
  pressed-background: $(raised_pressed.texture|$(raised.texture|sdf($(raised_pressed), 4, 1, $(border@70))));
}

color-selector:host .__color-selector_alpha-slider__ {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
  margin-right: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-slider__ {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
  margin-bottom: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-preview__ {
  background: $(field.texture|sdf($(field), 4, 1, $(border@4a)));
  margin-right: 3;
  margin-bottom: 3;
  padding-all: 2;
}

toggle:host {
  mark-background: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 72, 0, 12, 12);
  height: 14;
}

.__toggle_button__ {
  base-background: $(field.texture|sdf($(field), 4, 1, $(text_dim)));
  hover-background: $(raised.texture|sdf($(raised), 4, 1, $(text_note)));
  pressed-background: $(raised_pressed.texture|$(raised.texture|sdf($(raised_pressed), 4, 1, $(text_note))));
}

toggle:on .__toggle_button__ {
  base-background: $(accent.texture|sdf($(accent), 4));
  hover-background: $(accent_hover.texture|$(accent.texture|sdf($(accent_hover), 4)));
  pressed-background: $(accent_pressed.texture|$(accent.texture|sdf($(accent_pressed), 4)));
}

.__toggle_mark-icon__ {
  margin-all: 2;
  width: auto;
  height: auto;
  flex: 1;
}

text-area {
  scroller-view-margin: 8;
}

text-area:host {
  focus-overlay: sdf(#00000000, 5, 1, $(accent));
}

tree-list {
  collapse-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 188, 240, 5, 5) color($(text_soft));
  expand-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 132, 230, 5, 5) color($(text_soft));
}

.__text-area_content-view__ {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  padding-all: 3;
}

.__text-area_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__text-area_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

scroller-horizontal:host {
  height: 5;
}

scroller-vertical:host {
  width: 5;
}

.__scroller_scroll_container__ {
  background: $(field.texture|sdf($(field), 3));
  padding-all: 0;
}

scroller-horizontal .__scroller_scroll_bar__,
scroller-vertical .__scroller_scroll_bar__ {
  base-background: sdf($(border@50), 3);
  hover-background: sdf($(border@88), 3);
  pressed-background: $(accent.texture|sdf($(accent), 3));
}

.__scroller_head_button__, .__scroller_tail_button__ {
  display: none;
}

scroller-view {
  scroller-view-margin: 8;
}

.__scroller_view_view-port__ {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  padding-all: 3;
}

.__scroller_view_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

slider-horizontal:host {
  height: 10;
}

slider-vertical:host {
  width: 10;
}

slider-horizontal, slider-vertical {
  slider-track-size: 3;
  slider-handle-size: 5;
}

.__slider_track__ {
  background: $(field.texture|sdf($(field), 2, 1, $(border@4a)));
}

.__slider_fill__ {
  background: $(accent.texture|sdf($(accent), 2));
}

.__slider_handle__ {
  base-background: sdf($(text), 3);
  hover-background: $(accent_hover.texture|$(accent.texture|sdf($(accent_hover), 3)));
  pressed-background: $(accent.texture|sdf($(accent), 3));
}

.__tab-view_tab_header_container__ {
  background: $(field.texture|sdf($(field), 0 0 7 7, 1, $(border@4a)));
  margin-bottom: -1;
  padding-all: 3;
}

.__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 3;
}

.__tab-view_tab_content_container__ {
  background: $(panel.texture|sdf($(panel), 7 7 0 0, 1, $(border@4a)));
}

tab-view .__tab-view_tab_scroller__ {
  margin-bottom: 0;
}

tab:host {
  base-background: empty;
  hover-background: sdf($(border@4a), 5);
  pressed-background: $(accent.texture|sdf($(accent@3d), 5));
  padding-all: 3;
  height: 16;
}

tab:host:selected {
  base-background: $(panel.texture|sdf($(panel), 0 0 5 5));
  hover-background: $(panel.texture|sdf($(panel), 0 0 5 5));
  pressed-background: $(panel.texture|sdf($(panel), 0 0 5 5));
}

tab:host:not(tab:selected) label {
  text-color: $(text_soft);
  text-shadow: false;
}

.__dialog_overlay__ {
  background: $(panel.texture|sdf($(panel), 5));
}

.__dialog_title__ {
  background: $(raised.texture|sdf($(raised), 0 0 5 5, 1, $(border@70)));
  margin-bottom: -1;
}

.__dialog_title__ > label {
  text-color: $(text);
}

.__dialog_content-container__ {
  background: $(panel.texture|sdf($(panel), 0, 1, $(border@70)));
}

.__dialog_button-container__ {
  background: $(panel.texture|sdf($(panel), 5 5 0 0, 1, $(border@70)));
  margin-top: -1;
}

menu {
  background: $(panel.texture|sdf($(panel@f7), 6, 1, $(border@70)));
  arrow: sprite(ldlib2:textures/gui/right.png) scale(0.55) color($(text_soft));
}

.__editor__ code-editor {
  background: $(field.texture|sdf($(field), 6, 1, $(border@4a)));
}

.__editor_top__ {
  background: $(raised.texture|sdf($(raised), 0 0 6 6));
}

.__editor__ button:host {
  base-background: sdf(#00000000, 5, 1, $(border@4a));
  hover-background: sdf($(border@4a), 5, 1, $(border@70));
  pressed-background: $(accent.texture|sdf($(accent@3d), 5, 1, $(accent)));
}

.__editor__ tab:host {
  height: 15;
}

.__editor-gizmo-bar__ {
  background: $(panel.texture|sdf($(panel@f2), 6, 1, $(border@70)));
}

.__view-container__ {
  background: $(bg.texture|sdf($(bg)));
}

.__view-container_tab-view__ .__tab-view_tab_content_container__ {
  padding-all: 3;
}

.__view-container_collapse-button__ {
  height: 14;
  width: 14;
}

ResourceView .__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 2;
}

ResourceView tab:host {
  base-background: empty;
  hover-background: sdf($(border@4a), 5) scale(0.92);
  pressed-background: $(accent.texture|sdf($(accent@3d), 5) scale(0.92));
}

ResourceView tab:host:selected {
  base-background: $(panel.texture|sdf($(panel), 5) scale(0.92));
  hover-background: $(raised.texture|sdf($(raised), 5) scale(0.92));
  pressed-background: $(raised.texture|sdf($(raised), 5) scale(0.92));
}

.__resource-view_placement-left__ .__tab-view_tab_header_container__ {
  background: $(bg.texture|sdf($(bg), 7 0 0 7, 1, $(border@4a)));
  transform: translate(1, 0);
}

.__resource-view_placement-left__ .__tab-view_tab_content_container__ {
  background: $(panel.texture|sdf($(panel), 0 7 7 0, 1, $(border@4a)));
}

.__resource-view_placement-right__ .__tab-view_tab_header_container__ {
  background: $(bg.texture|sdf($(bg), 0 7 7 0, 1, $(border@4a)));
  transform: translate(-1, 0);
}

.__resource-view_placement-right__ .__tab-view_tab_content_container__ {
  background: $(panel.texture|sdf($(panel), 7 0 0 7, 1, $(border@4a)));
}

.__resource-view_placement-top__ .__tab-view_tab_header_container__ {
  background: $(bg.texture|sdf($(bg), 0 0 7 7, 1, $(border@4a)));
  transform: translate(0, 1);
}

.__resource-view_placement-top__ .__tab-view_tab_content_container__ {
  background: $(panel.texture|sdf($(panel), 7 7 0 0, 1, $(border@4a)));
}

.__resource-view_placement-bottom__ .__tab-view_tab_header_container__ {
  background: $(bg.texture|sdf($(bg), 7 7 0 0, 1, $(border@4a)));
  transform: translate(0, -1);
}

.__resource-view_placement-bottom__ .__tab-view_tab_content_container__ {
  background: $(panel.texture|sdf($(panel), 0 0 7 7, 1, $(border@4a)));
}

.__resource-view_tab-placeholder__ {
  background: $(accent.texture|sdf($(accent@3d), 5));
}

.__ui-editor-view_header__ {
  background: $(panel.texture|sdf($(panel)));
}

.__ui-editor-view_header__ button {
  height: 14;
}

.__ui-editor-view_header__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, $(border@4a));
  hover-background: sdf($(border@4a), 4, 1, $(border@70));
  pressed-background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent)));
}

.__ui-editor-view_canvas__ {
  background: $(field.texture|$(field));
}

.__ui-editor-view_builtin-styles-toggle__ {
  height: 14;
  padding-all: 0;
  mark-background: sdf(#00000000, 4, 1, $(accent));
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, $(border@4a));
  hover-background: sdf($(border@4a), 4, 1, $(border@70));
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_mark-icon__ {
  margin-all: 0;
}

.__ui-editor-view_style-view__ {
  background: empty;
  gap-all: 3;
}

.__editor-window_active__ {
  background: $(accent.texture|$(accent));
}

.__editor-window_inactive__ {
  background: $(raised.texture|$(raised));
}

.__configurator-group__ .__configurator-group_container__ {
  background: $(panel.texture|sdf($(panel), 6 6 6 0, 1, $(border@4a)));
}

.__configurator-group__ > .__configurator_line__ {
  background: $(bg.texture|sdf($(bg), 5, 1, $(border@4a)));
}

.__configurator-group__ > .__configurator_line__:hovered:not(:disabled) {
  background: $(raised.texture|sdf($(raised), 5, 1, $(border@70)));
}

.__configurator-group__ > .__configurator_line__ > .__configurator_label__ {
  text-color: $(text_soft);
  text-shadow: false;
}

ToggleSelectorConfigurator .__toggle_mark-icon__ {
  margin-all: 0;
}

ToggleSelectorConfigurator .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, $(border@4a));
  hover-background: sdf($(border@4a), 4, 1, $(border@70));
  pressed-background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent)));
}

.__array-configurator_button-group__ {
  background: sdf(#00000000, 5, 1, $(border@4a));
  padding-all: 2;
}

.__array-configurator_item_selected__ {
  background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent)));
}

.__blackboard-var-prop_title-bar__ {
  background: $(raised.texture|sdf($(raised), 0 0 6 6, 1, $(border@4a)));
}

.__blackboard-var-prop_content__ {
  background: $(panel.texture|sdf($(panel), 6 6 0 0, 1, $(border@4a)));
}

.__node-graph-view_canvas__ {
  background: $(field.texture|$(field));
}

.__node-graph-view_canvas-view__ {
  color: $(bg);
}

.__node-element__ {
  background: $(panel.texture|sdf($(panel@f2), 6, 1, $(border@70)));
}

.__node-title-element__ {
  background: $(raised.texture|sdf($(raised), 0 0 6 6, 1, $(border@4a)));
  padding-bottom: 4;
}

.__node-port-container__ {
  background: sdf(#00000000, 6 6 0 0);
}

.__in-out-port-container_input__ {
  background: sdf(#00000000);
  margin-all: 1;
}

.__in-out-port-container_output__ {
  background: sdf(#14000000);
  margin-all: 1;
}

.__capsule-node__ {
  background: $(raised.texture|sdf($(raised@f2), 8, 1, $(border@70)));
}

.__capsule-node__ .__node-title-element__ {
  background: empty;
  padding-bottom: 0;
}

.__capsule-node__ .__node-port-container__ {
  background: empty;
}

.__context-node__ > .__node-title-element__ {
  height: 30;
  gap-all: 5;
}

.__block-node__ > .__node-title-element__ {
  background: $(accent.texture|sdf($(accent@3d), 0 0 6 6, 1, $(accent)));
}

.__block-list-container__ {
  background: $(field.texture|sdf($(field), 6));
}

.__subgraph-node__ .__node-title-element__ {
  background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 0 0 6 6, 1, $(border@70))));
}

.__vertical-port-container__ {
  padding-all: 2;
  gap-all: 4;
}

.__vertical-port__ {
  padding-all: 1;
}

.__node-preview__ {
  background: $(field.texture|sdf($(field), 6 6 0 0, 1, $(border@4a)));
  padding-all: 3;
}

.__item-library__ {
  background: $(panel.texture|sdf($(panel@f7), 7, 1, $(accent)));
}

.__item-library_description-panel__ {
  background: $(panel.texture|sdf($(panel@f2), 7, 1, $(border@4a)));
  padding-all: 6;
  gap-all: 5;
}

.__keymap_chord__ {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
  transition: background 0.15 QUAD_OUT;
}

.__keymap_chord__:hovered {
  background: $(panel.texture|sdf($(panel), 5, 1, $(border@70)));
}

.__keymap_chord__.__capturing__ {
  background: $(field.texture|sdf($(field), 5, 1, $(accent)));
}

.__keymap_chord-text__ {
  text-color: $(text);
  text-shadow: false;
}

.__keymap_chord__.__conflict__ .__keymap_chord-text__ {
  text-color: $(danger);
}

#eq_root {
  background: $(panel.texture|sdf($(panel@f2), 7, 1, $(border@4a)));
}

#eq_title {
  text-color: $(text);
  font-size: 11;
}

#eq_header_count {
  text-color: $(accent);
}

#eq_header_total {
  text-color: $(text_note);
}

#eq_search_results {
  background: $(panel.texture|sdf($(panel@f2), 6, 1, $(border@4a)));
}

.eq_search_row {
  base-background: empty;
  hover-background: sdf($(border@4a), 4);
  pressed-background: $(accent.texture|sdf($(accent@3d), 4));
}

.eq_search_done .__button_text__ {
  text-color: $(success);
}

.eq_search_chapter, .eq_search_note {
  text-color: $(text_note);
}

.eq_node.eq_pulse {
  overlay: sdf(#00000000, 8, 2, $(accent)) scale(1.2);
}

#eq_chapters {
  background: $(field.texture|sdf($(field), 5, 1, $(border@4a)));
}

#eq_chapters .__scroller_view_view-port__ {
  background: empty;
}

.eq_chapter {
  base-background: empty;
  hover-background: sdf($(border@4a), 4);
  pressed-background: $(accent.texture|sdf($(accent@3d), 4));
}

.eq_chapter.eq_selected {
  base-background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent)));
  hover-background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent_hover)));
  pressed-background: $(accent.texture|sdf($(accent@3d), 4, 1, $(accent_pressed)));
}

.eq_chapter .__button_text__ {
  text-color: $(text);
}

.eq_chapter_count {
  text-color: $(text_note);
}

.eq_chapter_done .eq_chapter_count {
  text-color: $(success);
}

.eq_chapter .eq_chapter_count.eq_chapter_unclaimed {
  text-color: $(node_claimable_outline);
}

.eq_chapter_check {
  background: sprite(embersquesting:textures/gui/node_check_base.png) color($(node_check));
}

.eq_chapters_empty {
  text-color: $(text_note);
}

#eq_inbox_button, #eq_todo_button {
  base-background: $(raised.texture|sdf($(raised), 5, 1, $(border@4a)));
  hover-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 5, 1, $(border@70))));
}

#eq_panel {
  background: $(bg.texture|sdf($(bg), 5, 1, $(border@4a)));
}

#eq_panel_title {
  text-color: $(text);
  font-size: 10;
}

.eq_section, .eq_consequences_head {
  text-color: $(text_soft);
}

#eq_panel_desc > .eq_paragraph > label, #eq_panel_desc .eq_content_label, #eq_panel_desc .eq_scene_text, .eq_scene_zoom .eq_scene_text, #eq_panel_desc .eq_locate_label, #eq_panel_desc .eq_locate_result, .eq_story_text > .eq_paragraph > label, .eq_story_text .eq_content_label {
  text-color: $(text_soft);
}

.eq_task, .eq_reward {
  background: $(raised.texture|sdf($(raised), 4, 1, $(border@4a)));
}

.eq_task.eq_task_done {
  background: $(success.texture|sdf($(success@3d), 4, 1, $(success@90)));
}

.eq_task_text, .eq_reward_text {
  text-color: $(text);
}

.eq_task_done .eq_task_text {
  text-color: $(success);
}

.eq_task_bar .__progress-bar_bar__ {
  background: $(accent.texture|sdf($(accent), 3));
}

.eq_task_done .eq_task_bar .__progress-bar_bar__ {
  background: $(success.texture|sdf($(success), 3));
}

.eq_inbox_row {
  background: $(raised.texture|sdf($(raised), 4, 1, $(border@4a)));
  transition: background 0.15 QUAD_OUT;
}

.eq_inbox_row label {
  text-color: $(text);
}

.eq_inbox_row:hovered, .eq_inbox_row.eq_key_focus {
  background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 4, 1, $(border@70))));
}

.eq_submit, .eq_inbox_action:not(.__confirm-button__) {
  base-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 5, 1, $(accent))));
  hover-background: $(raised_hover.texture|$(raised.texture|sdf($(raised_hover), 5, 1, $(accent_hover))));
  pressed-background: $(raised.texture|sdf($(raised), 5, 1, $(accent_pressed)));
}

.eq_lookup:hovered {
  overlay: sdf($(text@30), 4);

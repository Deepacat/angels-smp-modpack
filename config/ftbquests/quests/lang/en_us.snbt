	quest.14DB2DC890D13F80.quest_desc: [
		"End remastered is present, requiring the end portal to have 12 different unique ender eyes obtained from various structures to activate."
		""
		"This should hopefully delay access to the end and make it a group effort!"
		""
		"Alongside this, ender trigon is installed making the dragon fight much more difficult. "
		""
		"So you'd want multiple people fairly geared up to take this on (especially since dying will do alot to your gear durability)"
	]
	quest.14DB2DC890D13F80.quest_subtitle: "Try speedrunning it anyways"
	quest.14DB2DC890D13F80.title: "End Portal \\& Dragon changes"
	quest.15367BE4A1789124.quest_desc: [
		"1. Be nice do not the killing eachother unless you know for sure they won't be upset"
		""
		"2. Do NOT nuke ANYWHERE within like 5k blocks of spawn I beg"
		""
		"3. Be reasonable with chunk claims, don't claim things you aren't using and don't forceload unessecary chunks"
	]

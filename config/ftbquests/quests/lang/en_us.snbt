	quest.060A4E7A5CA4A968.quest_desc: [
		"First of all you can &n&ltoggle off&r better combat swinging for yourself!"
		"Check the controls for the keybind \"Toggle better combat\" (Default B)"
		""
		"However, Better combat is tweaked to not be annoyingly sluggish! "
		""
		"It will not slow you when swinging, and there is no delay from your click to the swing happening"
	]

	quest.0E293D4FBF15AED7.quest_desc: [
		"Nuclear Tech Mod's structures can be very dangerous."
		""
		"With turrets, mobs with guns, or just generally radioactive!"
		""
		"If you care to interact with the mod and it's structures, be careful!"
		""
		"(Random bombs you find laying around will not explode randomly however they are slightly radioactive to be around)"
	]
